#!/bin/bash
set -euo pipefail

CC_SANDBOX_PREFIX="${CC_SANDBOX_PREFIX:-}"
CC_SANDBOX_IMAGE="${CC_SANDBOX_IMAGE:-${CC_SANDBOX_PREFIX}claude-code}"
CC_SANDBOX_NETWORK="${CC_SANDBOX_NETWORK:-${CC_SANDBOX_PREFIX}claude-code-network}"
CC_SANDBOX_INTERNAL_NETWORK="${CC_SANDBOX_INTERNAL_NETWORK:-${CC_SANDBOX_PREFIX}claude-code-internal-network}"
CC_SANDBOX_PROXY_CONTAINER="${CC_SANDBOX_PROXY_CONTAINER:-${CC_SANDBOX_PREFIX}claude-code-proxy}"
CC_SANDBOX_USER="${CC_SANDBOX_USER:-${CC_SANDBOX_PREFIX}claude}"
CC_SANDBOX_DOTCLAUDE="${CC_SANDBOX_DOTCLAUDE:-${HOME}/.${CC_SANDBOX_PREFIX}claude-in-sandbox/.claude}"
CC_SANDBOX_DOTCONFIG="${CC_SANDBOX_DOTCONFIG:-${HOME}/.${CC_SANDBOX_PREFIX}claude-in-sandbox/.config}"
CC_SANDBOX_SHARE_MISE_VOLUME="${CC_SANDBOX_SHARE_MISE_VOLUME:-${CC_SANDBOX_PREFIX}claude-code-share-mise}"
CC_SANDBOX_STATE_MISE_VOLUME="${CC_SANDBOX_STATE_MISE_VOLUME:-${CC_SANDBOX_PREFIX}claude-code-state-mise}"
CC_SANDBOX_M2_REPO="${CC_SANDBOX_M2_REPO:-${CC_SANDBOX_PREFIX}claude-code-m2-repo}"
CC_SANDBOX_M2_WRAPPER="${CC_SANDBOX_M2_WRAPPER:-${CC_SANDBOX_PREFIX}claude-code-m2-wrapper}"

show_usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Run Claude Code in a Docker sandbox.

Options:
  --cleanup         Stop and remove all Docker resources created by this script.
  --force, -f       Skip confirmation prompt when used with --cleanup.
  --list-mounts     Display all bind mounts and volumes used by the container.
  --volume, -v HOST:CT   Mount a host path into the container (can be repeated).
                         Format: HOST:CONTAINER or HOST:CONTAINER:ro
  --env, -e VAR=VALUE    Set an environment variable in the container (can be repeated).
                         Format: VAR=VALUE or VAR (inherits from host environment)
  --build, -b       Force rebuild the Docker image even if Dockerfile has not changed.
  --no-cache        Build the Docker image without using cache (implies --build).
  --help, -h        Show this help message and exit.
EOF
}

get_script_dir() {
  # BASH_SOURCE が使えるならそれを優先（bash/zsh）
  if [ -n "${BASH_SOURCE[0]}" ]; then
    SOURCE="${BASH_SOURCE[0]}"
  else
    SOURCE="$0"
  fi

  # シンボリックリンクを辿る
  while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
      /*) ;;                     # 絶対パスならそのまま
      *) SOURCE="$DIR/$SOURCE" ;; # 相対パスなら補完
    esac
  done

  # 実体ファイルのあるディレクトリを取得
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

script_dir="$(get_script_dir)"
workspace="$PWD"
remote_user_home="/home/${CC_SANDBOX_USER}"

build_image() {
    local dockerfile_path
    dockerfile_path="${script_dir}/Dockerfile"
    local current_hash
    current_hash="$(sha256sum "$dockerfile_path" | cut -d' ' -f1)"
    local build_args=()
    if [ "$NO_CACHE" = "true" ]; then
        build_args+=("--no-cache")
    fi

    if [ "$BUILD" = "true" ]; then
        echo "Building image '$CC_SANDBOX_IMAGE'..."
        docker build \
            "${build_args[@]+"${build_args[@]}"}" \
            --label "dockerfile_hash=${current_hash}" \
            --build-arg USERNAME="$CC_SANDBOX_USER" \
            --tag "$CC_SANDBOX_IMAGE" \
            "$script_dir"
        echo "Image '$CC_SANDBOX_IMAGE' built."
    elif ! docker image inspect "$CC_SANDBOX_IMAGE" > /dev/null 2>&1; then
        echo "Image '$CC_SANDBOX_IMAGE' does not exist. Building..."
        docker build \
            "${build_args[@]+"${build_args[@]}"}" \
            --label "dockerfile_hash=${current_hash}" \
            --build-arg USERNAME="$CC_SANDBOX_USER" \
            --tag "$CC_SANDBOX_IMAGE" \
            "$script_dir"
        echo "Image '$CC_SANDBOX_IMAGE' built."
    else
        local stored_hash
        stored_hash="$(docker image inspect "$CC_SANDBOX_IMAGE" \
            --format '{{index .Config.Labels "dockerfile_hash"}}' 2>/dev/null || echo "")"
        if [ "$stored_hash" != "$current_hash" ]; then
            echo "Dockerfile has changed. Rebuilding image '$CC_SANDBOX_IMAGE'..."
            docker build \
                "${build_args[@]+"${build_args[@]}"}" \
                --label "dockerfile_hash=${current_hash}" \
                --build-arg USERNAME="$CC_SANDBOX_USER" \
                --tag "$CC_SANDBOX_IMAGE" \
                "$script_dir"
            echo "Image '$CC_SANDBOX_IMAGE' rebuilt."
        fi
    fi
}

cleanup() {
    local force="${1:-false}"

    if [ "$force" != "true" ]; then
        if [ ! -t 0 ]; then
            echo "Non-interactive mode: use --force to skip confirmation." >&2
            exit 1
        fi
        echo "This will remove the following Docker resources:"
        echo "  Container: $CC_SANDBOX_PROXY_CONTAINER"
        echo "  Network:   $CC_SANDBOX_INTERNAL_NETWORK"
        echo "  Network:   $CC_SANDBOX_NETWORK"
        echo "  Image:     $CC_SANDBOX_IMAGE"
        echo "  Volume:    $CC_SANDBOX_SHARE_MISE_VOLUME"
        echo "  Volume:    $CC_SANDBOX_STATE_MISE_VOLUME"
        echo "  Volume:    $CC_SANDBOX_M2_REPO"
        echo "  Volume:    $CC_SANDBOX_M2_WRAPPER"
        echo ""
        echo "Host directories will NOT be removed."
        echo ""
        printf "Continue? [y/N] "
        read -r answer
        case "$answer" in
            [Yy]*) ;;
            *) echo "Aborted."; exit 0 ;;
        esac
    fi

    if docker inspect "$CC_SANDBOX_PROXY_CONTAINER" > /dev/null 2>&1; then
        echo "Stopping container '$CC_SANDBOX_PROXY_CONTAINER'..."
        docker stop "$CC_SANDBOX_PROXY_CONTAINER"
        echo "Removing container '$CC_SANDBOX_PROXY_CONTAINER'..."
        docker rm "$CC_SANDBOX_PROXY_CONTAINER"
    fi

    echo "Removing network '$CC_SANDBOX_INTERNAL_NETWORK'..."
    docker network rm "$CC_SANDBOX_INTERNAL_NETWORK" 2>/dev/null || true
    echo "Removing network '$CC_SANDBOX_NETWORK'..."
    docker network rm "$CC_SANDBOX_NETWORK" 2>/dev/null || true

    echo "Removing image '$CC_SANDBOX_IMAGE'..."
    docker image rm "$CC_SANDBOX_IMAGE" 2>/dev/null || true

    echo "Removing volume '$CC_SANDBOX_SHARE_MISE_VOLUME'..."
    docker volume rm "$CC_SANDBOX_SHARE_MISE_VOLUME" 2>/dev/null || true
    echo "Removing volume '$CC_SANDBOX_STATE_MISE_VOLUME'..."
    docker volume rm "$CC_SANDBOX_STATE_MISE_VOLUME" 2>/dev/null || true

    echo "Removing volume '$CC_SANDBOX_M2_REPO'..."
    docker volume rm "$CC_SANDBOX_M2_REPO" 2>/dev/null || true
    echo "Removing volume '$CC_SANDBOX_M2_WRAPPER'..."
    docker volume rm "$CC_SANDBOX_M2_WRAPPER" 2>/dev/null || true

    echo "Cleanup complete."
}

list_mounts() {
    echo "Bind mounts:"
    echo "  ${CC_SANDBOX_DOTCLAUDE} → ${remote_user_home}/.claude"
    echo "  ${CC_SANDBOX_DOTCONFIG} → ${remote_user_home}/.config"
    echo "  ${script_dir}/proxy/maven/settings.xml → ${remote_user_home}/.m2/settings.xml (read-only)"
    echo "  ${PWD} → ${workspace}"
    echo ""
    echo "Named volumes:"
    echo "  ${CC_SANDBOX_SHARE_MISE_VOLUME} → ${remote_user_home}/.local/share/mise"
    echo "  ${CC_SANDBOX_STATE_MISE_VOLUME} → ${remote_user_home}/.local/state/mise"
    echo "  ${CC_SANDBOX_M2_REPO} → ${remote_user_home}/.m2/repository"
    echo "  ${CC_SANDBOX_M2_WRAPPER} → ${remote_user_home}/.m2/wrapper"
    if [[ ${#extra_volumes[@]} -gt 0 ]]; then
        echo ""
        echo "Additional mounts (--volume):"
        local i
        for (( i=1; i<${#extra_volumes[@]}; i+=2 )); do
            echo "  ${extra_volumes[$i]}"
        done
    fi
    if [[ ${#extra_envs[@]} -gt 0 ]]; then
        echo ""
        echo "Additional environment variables (--env):"
        local i
        for (( i=1; i<${#extra_envs[@]}; i+=2 )); do
            echo "  ${extra_envs[$i]}"
        done
    fi
}

CLEANUP=false
FORCE=false
LIST_MOUNTS=false
BUILD=false
NO_CACHE=false
extra_volumes=()
extra_envs=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cleanup)     CLEANUP=true; shift ;;
        --force|-f)    FORCE=true; shift ;;
        --list-mounts) LIST_MOUNTS=true; shift ;;
        --build|-b)    BUILD=true; shift ;;
        --no-cache)    NO_CACHE=true; BUILD=true; shift ;;
        --help|-h)     show_usage; exit 0 ;;
        --volume|-v)
            if [[ $# -lt 2 ]]; then
                echo "Error: $1 requires an argument." >&2
                show_usage >&2
                exit 1
            fi
            extra_volumes+=("-v" "$2")
            shift 2
            ;;
        --env|-e)
            if [[ $# -lt 2 ]]; then
                echo "Error: $1 requires an argument." >&2
                show_usage >&2
                exit 1
            fi
            extra_envs+=("-e" "$2")
            shift 2
            ;;
        *) echo "Unknown option: $1" >&2; show_usage >&2; exit 1 ;;
    esac
done

if [ "$CLEANUP" = "true" ]; then
    cleanup "$FORCE"
    exit 0
fi

if [ "$LIST_MOUNTS" = "true" ]; then
    list_mounts
    exit 0
fi

build_image

# ネットワークがなければ作成する
if ! docker network inspect "$CC_SANDBOX_NETWORK" > /dev/null 2>&1; then
	echo "Network '$CC_SANDBOX_NETWORK' does not exist. Creating..."
	docker network create "$CC_SANDBOX_NETWORK"
	echo "Network '$CC_SANDBOX_NETWORK' created."
fi

# 内部ネットワークがなければ作成する
if ! docker network inspect "$CC_SANDBOX_INTERNAL_NETWORK" > /dev/null 2>&1; then
	echo "Network '$CC_SANDBOX_INTERNAL_NETWORK' does not exist. Creating..."
	docker network create --internal "$CC_SANDBOX_INTERNAL_NETWORK"
	echo "Network '$CC_SANDBOX_INTERNAL_NETWORK' created."
fi

# proxyがなければ起動する
if ! docker inspect "$CC_SANDBOX_PROXY_CONTAINER" > /dev/null 2>&1; then
	echo "Container '$CC_SANDBOX_PROXY_CONTAINER' does not exist. Creating..."
	proxy_asset_path="${script_dir}/proxy"
	docker run --detach --name "$CC_SANDBOX_PROXY_CONTAINER" \
		--hostname "${CC_SANDBOX_PROXY_CONTAINER}.test" \
		--network "$CC_SANDBOX_INTERNAL_NETWORK" \
		--volume "${proxy_asset_path}/squid.conf:/etc/squid/conf.d/_squid.conf:ro" \
		--volume "${proxy_asset_path}/whitelist.txt:/etc/squid/whitelist.txt:ro" \
		ubuntu/squid
	docker network connect "$CC_SANDBOX_NETWORK" "$CC_SANDBOX_PROXY_CONTAINER"
	echo "Container '$CC_SANDBOX_PROXY_CONTAINER' created."
fi

# proxyが起動していなければ起動する
if [ "$(docker inspect -f '{{.State.Running}}' "$CC_SANDBOX_PROXY_CONTAINER" 2> /dev/null)" = "false" ]; then
	echo "Container '$CC_SANDBOX_PROXY_CONTAINER' is stopped. Starting..."
	docker start "$CC_SANDBOX_PROXY_CONTAINER"
	echo "Container '$CC_SANDBOX_PROXY_CONTAINER' started."
fi

# ディレクトリがなければ作成する
if [ ! -d "$CC_SANDBOX_DOTCLAUDE" ]; then
	echo "Directory '$CC_SANDBOX_DOTCLAUDE' does not exist. Creating..."
	mkdir -p "$CC_SANDBOX_DOTCLAUDE"
	echo "Directory '$CC_SANDBOX_DOTCLAUDE' created."
fi
if [ ! -d "$CC_SANDBOX_DOTCONFIG" ]; then
	echo "Directory '$CC_SANDBOX_DOTCONFIG' does not exist. Creating..."
	mkdir -p "$CC_SANDBOX_DOTCONFIG"
	cp -r "${script_dir}/template/config/." "$CC_SANDBOX_DOTCONFIG/"
	echo "Directory '$CC_SANDBOX_DOTCONFIG' created."
fi

network_cidr="$(docker network inspect "$CC_SANDBOX_INTERNAL_NETWORK" --format '{{(index .IPAM.Config 0).Subnet}}')"

echo "Starting Claude Code sandbox in workspace '$workspace'..."
docker run -it --rm \
  --network "$CC_SANDBOX_INTERNAL_NETWORK" \
  -e "http_proxy=http://${CC_SANDBOX_PROXY_CONTAINER}.test:3128" \
  -e "https_proxy=http://${CC_SANDBOX_PROXY_CONTAINER}.test:3128" \
  -e "no_proxy=127.0.0.1,localhost,${network_cidr},.test" \
  -e "CLAUDE_CODE_PROXY_HOST=${CC_SANDBOX_PROXY_CONTAINER}.test" \
  -v "${CC_SANDBOX_DOTCLAUDE}:${remote_user_home}/.claude" \
  -v "${CC_SANDBOX_DOTCONFIG}:${remote_user_home}/.config" \
  -v "${CC_SANDBOX_SHARE_MISE_VOLUME}:${remote_user_home}/.local/share/mise" \
  -v "${CC_SANDBOX_STATE_MISE_VOLUME}:${remote_user_home}/.local/state/mise" \
  -v "${PWD}:${workspace}" \
  -v "${script_dir}/proxy/maven/settings.xml:${remote_user_home}/.m2/settings.xml:ro" \
  -v "${CC_SANDBOX_M2_REPO}:${remote_user_home}/.m2/repository" \
  -v "${CC_SANDBOX_M2_WRAPPER}:${remote_user_home}/.m2/wrapper" \
  ${extra_volumes[@]+"${extra_volumes[@]}"} \
  ${extra_envs[@]+"${extra_envs[@]}"} \
  -w "$workspace" \
  "$CC_SANDBOX_IMAGE" bash
