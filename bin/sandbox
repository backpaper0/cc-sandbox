#!/usr/bin/env bash
# CLI entrypoint for the isolated dev sandbox (see .scratch/isolated-dev-sandbox/spec.md).
set -euo pipefail

SANDBOX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${SANDBOX_ROOT}/sandbox/docker-compose.yml"

# The non-root account inside the image (sandbox/Dockerfile's USERNAME), i.e. the
# user whose traffic the isolation rules apply to.
SANDBOX_USER=dev

usage() {
  cat <<'EOF'
Usage:
  bin/sandbox up <project-dir> [--profile <private|work>]
  bin/sandbox down [project-dir]

  up    Build and start the sandbox container, bind-mounting <project-dir> at /workspace.
        --profile loads ~/.sandbox/env.<profile> (see docs/adr/0003) and injects its
        variables into the container so Claude Code is authenticated without an
        interactive login.
  down  Tear down the sandbox instance. If <project-dir> is omitted, the single
        running instance (if there is exactly one) is torn down.
EOF
}

# Resolves --profile <private|work> to its host-side, git-ignored env file
# (see docs/adr/0003-auth-injection-per-host-profile.md). Fails loudly rather than
# silently skipping injection, since a sandbox that looks up but isn't actually
# authenticated is a confusing failure mode to debug from inside bypass permissions.
resolve_profile_env_file() {
  local profile="$1"
  case "${profile}" in
    private | work) ;;
    "")
      echo "error: --profile requires a non-empty value ('private' or 'work')" >&2
      exit 1
      ;;
    *)
      echo "error: unknown profile '${profile}' (expected 'private' or 'work')" >&2
      exit 1
      ;;
  esac

  if [[ -z "${HOME:-}" ]]; then
    echo "error: \$HOME is not set; cannot resolve --profile ${profile}" >&2
    exit 1
  fi

  local path="${HOME}/.sandbox/env.${profile}"
  if [[ ! -f "${path}" ]]; then
    echo "error: profile file not found: ${path}" >&2
    echo "Create it with the '${profile}' profile's environment variables before using --profile ${profile}." >&2
    exit 1
  fi
  echo "${path}"
}

slugify() {
  # $1 must already be a canonicalized absolute path (see compose_project_name
  # callers), so the hash suffix uniquely ties the slug to that exact directory
  # and two different paths sharing a basename (e.g. two "backend" checkouts)
  # don't collide on the same compose project name.
  local input="$1"
  local base
  base="$(basename "${input}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')"
  base="${base#-}"
  base="${base%-}"
  local hash
  hash="$(printf '%s' "${input}" | sha256sum | cut -c1-8)"
  echo "${base:-sandbox}-${hash}"
}

compose_project_name() {
  echo "sandbox-$(slugify "$1")"
}

compose() {
  local project_name="$1"
  shift
  docker compose -p "${project_name}" -f "${COMPOSE_FILE}" "$@"
}

# Applies the isolation rules from inside the container, as root
# (see docs/adr/0004-network-isolation-in-container-owner-match.md).
# Nothing is installed on the host, so `down` has no rules to clean up -- they die
# with the container.
apply_network_isolation() {
  local container_id="$1"
  docker exec -u root "${container_id}" /usr/local/sbin/sandbox-isolate "${SANDBOX_USER}"
}

cmd_up() {
  local project_dir=""
  local profile=""
  local profile_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        if [[ $# -lt 2 ]]; then
          echo "error: --profile requires an argument" >&2
          exit 1
        fi
        profile="$2"
        profile_given=true
        shift 2
        ;;
      --profile=*)
        profile="${1#--profile=}"
        profile_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${project_dir}" ]]; then
    echo "error: 'up' requires a project directory" >&2
    usage >&2
    exit 1
  fi

  project_dir="$(cd "${project_dir}" && pwd -P)"
  local project_name
  project_name="$(compose_project_name "${project_dir}")"

  # /dev/null keeps docker-compose.yml's env_file resolvable even without --profile.
  local env_file="/dev/null"
  if [[ "${profile_given}" == true ]]; then
    env_file="$(resolve_profile_env_file "${profile}")"
  fi

  export PROJECT_DIR="${project_dir}"
  export SANDBOX_ENV_FILE="${env_file}"

  compose "${project_name}" up -d --build

  local container_id
  container_id="$(compose "${project_name}" ps -q sandbox)"

  # Fail closed: a sandbox that came up without its isolation rules is worse than
  # no sandbox at all, since the whole point is to run Claude Code unsupervised in it.
  if [[ -z "${container_id}" ]] || ! apply_network_isolation "${container_id}"; then
    echo "error: failed to apply network isolation for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  echo
  echo "Sandbox '${project_name}' is up."
  echo "  Project dir: ${project_dir} -> /workspace"
  echo "  Enter with:  docker exec -it -u dev ${container_id} bash"
}

running_sandbox_project_names() {
  docker ps --filter 'label=com.docker.compose.project' --format '{{.Label "com.docker.compose.project"}}' \
    | sort -u | grep '^sandbox-' || true
}

cmd_down() {
  local project_name
  # `down` only removes resources, so it never materializes the bind mount -- but
  # compose still validates the volume spec while loading the file, and an empty
  # PROJECT_DIR turns that spec into ":/workspace", which compose rejects. Keep a
  # valid absolute path for the no-argument form, where the dir isn't known.
  local project_dir="/nonexistent"
  if [[ $# -ge 1 ]]; then
    project_dir="$(cd "$1" && pwd -P)"
    project_name="$(compose_project_name "${project_dir}")"
  else
    local names
    names="$(running_sandbox_project_names)"
    local count
    count="$(grep -c . <<<"${names}" || true)"
    if [[ -z "${names}" || "${count}" -eq 0 ]]; then
      echo "error: no running sandbox instances found" >&2
      exit 1
    elif [[ "${count}" -gt 1 ]]; then
      echo "error: multiple sandbox instances running, specify a project directory:" >&2
      echo "${names}" >&2
      exit 1
    fi
    project_name="${names}"
  fi

  # The isolation rules live inside the container, so removing it removes them too.
  export PROJECT_DIR="${project_dir}"
  export SANDBOX_ENV_FILE="/dev/null"
  compose "${project_name}" down
}

main() {
  local sub="${1:-}"
  case "${sub}" in
    up)
      shift
      cmd_up "$@"
      ;;
    down)
      shift
      cmd_down "$@"
      ;;
    -h | --help | "")
      usage
      ;;
    *)
      echo "error: unknown subcommand '${sub}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
