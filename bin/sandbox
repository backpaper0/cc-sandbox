#!/usr/bin/env bash
# CLI entrypoint for the isolated dev sandbox (see .scratch/isolated-dev-sandbox/spec.md).
set -euo pipefail

SANDBOX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${SANDBOX_ROOT}/sandbox/docker-compose.yml"

# The non-root account inside the image (sandbox/Dockerfile's USERNAME), i.e. the
# user whose traffic the isolation rules apply to.
SANDBOX_USER=dev

usage() {
  cat <<'EOF'
Usage:
  bin/sandbox up <project-dir> [--profile <private|work>] [--name <slug>]
  bin/sandbox down [project-dir] [--name <slug>]
  bin/sandbox list

  up    Build and start the sandbox container, bind-mounting <project-dir> at /workspace.
        --profile loads ~/.sandbox/env.<profile> (see docs/adr/0003) and injects its
        variables into the container so Claude Code is authenticated without an
        interactive login.
        --name gives the instance an explicit slug, so multiple instances (e.g. of
        the same or different project dirs) can run side by side (see ticket 06).
        Without --name, the instance is named after <project-dir> as before.
  down  Tear down a sandbox instance, identified by <project-dir> or by --name
        (whichever the matching 'up' used). If neither is given, the single
        running instance (if there is exactly one) is torn down.
  list  Show every currently running sandbox instance: its name/slug, the
        project directory it has mounted, and its code-server address.
EOF
}

# Resolves --profile <private|work> to its host-side, git-ignored env file
# (see docs/adr/0003-auth-injection-per-host-profile.md). Fails loudly rather than
# silently skipping injection, since a sandbox that looks up but isn't actually
# authenticated is a confusing failure mode to debug from inside bypass permissions.
resolve_profile_env_file() {
  local profile="$1"
  case "${profile}" in
    private | work) ;;
    "")
      echo "error: --profile requires a non-empty value ('private' or 'work')" >&2
      exit 1
      ;;
    *)
      echo "error: unknown profile '${profile}' (expected 'private' or 'work')" >&2
      exit 1
      ;;
  esac

  if [[ -z "${HOME:-}" ]]; then
    echo "error: \$HOME is not set; cannot resolve --profile ${profile}" >&2
    exit 1
  fi

  local path="${HOME}/.sandbox/env.${profile}"
  if [[ ! -f "${path}" ]]; then
    echo "error: profile file not found: ${path}" >&2
    echo "Create it with the '${profile}' profile's environment variables before using --profile ${profile}." >&2
    exit 1
  fi
  echo "${path}"
}

# Shared by slugify() and sanitize_name() below, so the charset a compose project
# name is allowed to contain lives in exactly one place.
to_dash_charset() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-'
}

slugify() {
  # $1 must already be a canonicalized absolute path (see compose_project_name
  # callers), so the hash suffix uniquely ties the slug to that exact directory
  # and two different paths sharing a basename (e.g. two "backend" checkouts)
  # don't collide on the same compose project name.
  local input="$1"
  local base
  base="$(to_dash_charset "$(basename "${input}")")"
  base="${base#-}"
  base="${base%-}"
  local hash
  hash="$(printf '%s' "${input}" | sha256sum | cut -c1-8)"
  echo "${base:-sandbox}-${hash}"
}

compose_project_name() {
  echo "sandbox-$(slugify "$1")"
}

# Sanitizes a user-supplied --name into the same charset slugify() produces, but
# without slugify's path-hash suffix: an explicit --name is already unique by the
# user's choice (that's the point of ticket 06 -- decoupling the instance identity
# from the project directory), so no collision-avoidance suffix is needed.
# `return 1` (not `exit`) on an empty result: called via command substitution
# below, and a plain `set -e` does not treat a failed command substitution on the
# right-hand side of an assignment as fatal, so `exit` here would only kill the
# subshell and silently leave callers with an empty/malformed name. `|| exit 1` at
# each call site is what actually stops the script.
sanitize_name() {
  local input="$1"
  local out
  out="$(to_dash_charset "${input}")"
  # Strip *all* leading/trailing dashes, not just one: unlike slugify()'s
  # basename handling, there's no hash suffix here to fall back on, so e.g.
  # "__" must reduce all the way to empty (and get rejected below) rather than
  # leaving a bare "-" as a project name.
  out="$(printf '%s' "${out}" | sed -e 's/^-*//' -e 's/-*$//')"
  if [[ -z "${out}" ]]; then
    echo "error: --name must contain at least one letter or digit" >&2
    return 1
  fi
  echo "${out}"
}

compose_project_name_for_name() {
  local slug
  slug="$(sanitize_name "$1")" || return 1
  echo "sandbox-${slug}"
}

compose() {
  local project_name="$1"
  shift
  docker compose -p "${project_name}" -f "${COMPOSE_FILE}" "$@"
}

# Fails closed rather than letting `docker compose up` silently redefine an
# existing instance: without this check, `up <dirB> --name shared` while `up
# <dirA> --name shared` is still running would make compose recreate the
# `sandbox` service in place with dirB's bind mount -- i.e. one instance
# silently clobbers another's container, exactly what --name (ticket 06) is
# meant to prevent by letting instances be told apart by name instead of only
# by directory. Only relevant to the --name path: the directory-derived path
# already ties the project name 1:1 to that directory, so re-running `up`
# against the same directory is the existing, intentional "keep isolation
# up to date" behavior (see network_isolation.bats).
# The host path bind-mounted at /workspace in the given container -- shared by
# check_name_not_in_use_by_other_dir (collision guard) and list_row (`list`
# output), so this inspect --format template lives in exactly one place.
container_workspace_dir() {
  docker inspect "$1" \
    --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}'
}

check_name_not_in_use_by_other_dir() {
  local project_name="$1"
  local project_dir="$2"
  local existing_container
  # Requires PROJECT_DIR to already be exported: docker-compose.yml's
  # `${PROJECT_DIR}:/workspace` has no `:-` default, so without it `compose ps`
  # fails validation outright (rather than reporting "no container") and that
  # failure is swallowed by `|| true` below -- silently turning this whole guard
  # into a no-op. (Found in review: this used to run before cmd_up exported
  # PROJECT_DIR.)
  if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo "error: internal: check_name_not_in_use_by_other_dir called before PROJECT_DIR was exported" >&2
    exit 1
  fi
  existing_container="$(compose "${project_name}" ps -q sandbox 2>/dev/null || true)"
  if [[ -z "${existing_container}" ]]; then
    return 0
  fi
  local existing_dir
  existing_dir="$(container_workspace_dir "${existing_container}")"
  if [[ -n "${existing_dir}" && "${existing_dir}" != "${project_dir}" ]]; then
    echo "error: an instance named '${project_name#sandbox-}' is already running for a different project directory (${existing_dir})" >&2
    echo "Tear it down first with 'bin/sandbox down --name ${project_name#sandbox-}', or choose a different --name." >&2
    exit 1
  fi
}

# Serializes check_name_not_in_use_by_other_dir's check-then-act sequence (and the
# `compose up` that follows it) against another concurrent `up --name` claiming the
# *same* brand-new name: without this, two `up --name shared` invocations racing
# against each other can both see "not in use yet" before either has created a
# container, both pass the guard, and the second `compose up -d --build` silently
# recreates/clobbers the first's container (found in review). `mkdir` is atomic on
# POSIX filesystems, unlike a check-then-create on a plain file, so only one
# concurrent invocation can hold this lock for a given project name at a time. The
# trap releases it on the *script's* exit (success or failure), which is also when
# `up` has either finished creating the container or given up -- i.e. for exactly
# as long as the race window is open.
acquire_name_lock() {
  local project_name="$1"
  local lock_dir="${TMPDIR:-/tmp}/sandbox-lock-${project_name}"
  local waited=0
  while ! mkdir "${lock_dir}" 2>/dev/null; do
    sleep 0.2
    waited=$((waited + 1))
    if [[ "${waited}" -gt 150 ]]; then
      echo "error: timed out waiting for another 'bin/sandbox up --name ${project_name#sandbox-}' to finish" >&2
      exit 1
    fi
  done
  # lock_dir must expand now, not when the trap fires.
  # shellcheck disable=SC2064
  trap "rmdir '${lock_dir}' 2>/dev/null || true" EXIT
}

# Applies the isolation rules from inside the container, as root
# (see docs/adr/0004-network-isolation-in-container-owner-match.md).
# Nothing is installed on the host, so `down` has no rules to clean up -- they die
# with the container.
apply_network_isolation() {
  local container_id="$1"
  docker exec -u root "${container_id}" /usr/local/sbin/sandbox-isolate "${SANDBOX_USER}"
}

# Populates a Playwright cache volume created before ticket 10. This deliberately
# runs only after apply_network_isolation: doing it from the container entrypoint
# could start a browser download in the gap before the OUTPUT rules are installed
# (the startup-window constraint documented by ADR-0004). New volumes are already
# seeded from the image, so this is normally a cheap no-op. The shared-volume lock
# serializes the one-time repair when multiple instances start together.
ensure_playwright_browser() {
  local container_id="$1"
  docker exec -u "${SANDBOX_USER}" "${container_id}" bash -lc '
    mkdir -p "${HOME}/.cache/ms-playwright"
    (
      flock 9
      playwright install chromium
    ) 9>"${HOME}/.cache/ms-playwright/.install.lock"
  '
}

# Applies the DinD sidecar's isolation rules (ticket 05, see
# sandbox/isolate-forward.sh): blocks containers started inside it from reaching
# host-side services, the same way apply_network_isolation does for the sandbox
# container itself.
apply_dind_network_isolation() {
  local project_name="$1"
  local dind_container_id
  dind_container_id="$(compose "${project_name}" ps -q dind)"
  if [[ -z "${dind_container_id}" ]]; then
    return 1
  fi
  docker exec -u root "${dind_container_id}" sh /usr/local/sbin/sandbox-isolate-forward
}

# Shared by wait_for_dind/wait_for_code_server below: both are "poll a readiness
# command inside the container for up to 30s" and differ only in that command.
wait_until() {
  local container_id="$1"
  shift
  local _
  for _ in $(seq 1 30); do
    if docker exec -u "${SANDBOX_USER}" "${container_id}" "$@" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# The nested Docker daemon in the `dind` service takes a moment to start listening
# after the container itself is running. Poll instead of assuming it's ready, so
# `up` doesn't report success before `docker`/Testcontainers actually work inside
# the sandbox.
wait_for_dind() {
  wait_until "$1" docker info
}

# code-server (a Node process) takes a moment to start listening after the
# container itself is running. Poll instead of assuming it's ready, so `up`
# doesn't report a URL that isn't actually serving anything yet.
wait_for_code_server() {
  wait_until "$1" curl -sS -m 2 -o /dev/null http://127.0.0.1:8080/
}

# True if some *other* already-running instance's dind sidecar currently has the
# globally-shared Docker image-layer cache volume mounted. containerd's metadata
# store inside that volume takes an exclusive lock on dockerd startup, so a second
# dind sharing it concurrently would hang rather than start (see
# sandbox/docker-compose.yml's DIND_CACHE_VOLUME comment; verified directly in
# review against two real docker:28-dind containers). Excludes the given project's
# own containers so re-running `up` on an already-running instance doesn't flip its
# own cache from shared to per-instance on every call.
dind_cache_volume_in_use_by_other_project() {
  local volume_name="$1"
  local own_project_name="$2"
  local cid other_project
  for cid in $(docker ps -q --filter "volume=${volume_name}"); do
    other_project="$(docker inspect "${cid}" --format '{{ index .Config.Labels "com.docker.compose.project" }}' 2>/dev/null || true)"
    if [[ -n "${other_project}" && "${other_project}" != "${own_project_name}" ]]; then
      return 0
    fi
  done
  return 1
}

cmd_up() {
  local project_dir=""
  local profile=""
  local profile_given=false
  local name=""
  local name_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        if [[ $# -lt 2 ]]; then
          echo "error: --profile requires an argument" >&2
          exit 1
        fi
        profile="$2"
        profile_given=true
        shift 2
        ;;
      --profile=*)
        profile="${1#--profile=}"
        profile_given=true
        shift
        ;;
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${project_dir}" ]]; then
    echo "error: 'up' requires a project directory" >&2
    usage >&2
    exit 1
  fi

  project_dir="$(cd "${project_dir}" && pwd -P)"
  # Exported before any `compose` call below (including inside
  # check_name_not_in_use_by_other_dir), since docker-compose.yml's
  # `${PROJECT_DIR}:/workspace` has no default and compose validates it while
  # loading the file even for a plain `ps`.
  export PROJECT_DIR="${project_dir}"

  local project_name
  if [[ "${name_given}" == true ]]; then
    project_name="$(compose_project_name_for_name "${name}")" || exit 1
    acquire_name_lock "${project_name}"
    check_name_not_in_use_by_other_dir "${project_name}" "${project_dir}"
  else
    project_name="$(compose_project_name "${project_dir}")"
  fi

  # /dev/null keeps docker-compose.yml's env_file resolvable even without --profile.
  local env_file="/dev/null"
  if [[ "${profile_given}" == true ]]; then
    env_file="$(resolve_profile_env_file "${profile}")"
  fi
  export SANDBOX_ENV_FILE="${env_file}"

  # ticket 07: use the globally-shared Docker image-layer cache volume unless
  # another already-running instance currently holds it (see
  # dind_cache_volume_in_use_by_other_project and docker-compose.yml's
  # DIND_CACHE_VOLUME comment for why sharing it concurrently doesn't work).
  local dind_cache_volume="sandbox-cache-docker-layers"
  if dind_cache_volume_in_use_by_other_project "${dind_cache_volume}" "${project_name}"; then
    dind_cache_volume="sandbox-cache-docker-layers-${project_name}"
  fi
  export DIND_CACHE_VOLUME="${dind_cache_volume}"

  compose "${project_name}" up -d --build

  local container_id
  container_id="$(compose "${project_name}" ps -q sandbox)"

  # Fail closed: a sandbox that came up without its isolation rules is worse than
  # no sandbox at all, since the whole point is to run Claude Code unsupervised in it.
  if [[ -z "${container_id}" ]] || ! apply_network_isolation "${container_id}"; then
    echo "error: failed to apply network isolation for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  if ! ensure_playwright_browser "${container_id}"; then
    echo "error: failed to install the Playwright browser in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  # wait_for_dind before apply_dind_network_isolation, not after: the nested dockerd
  # installs its own DOCKER-USER/DOCKER-FORWARD chains ahead of anything already in
  # FORWARD when *it* starts up (see sandbox/isolate-forward.sh and docs/adr/0004's
  # addendum). Applying our rule first would let a dockerd that finishes starting
  # afterward re-take the top position with its own ACCEPT, silently defeating the
  # isolation. `docker info` succeeding is a reasonable proxy for "dockerd has
  # already set up its own chains", since that happens during its startup, before
  # the API responds.
  if ! wait_for_dind "${container_id}"; then
    echo "error: DinD sidecar did not become ready in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  if ! apply_dind_network_isolation "${project_name}"; then
    echo "error: failed to apply network isolation for the DinD sidecar in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  # Fail closed here too: a sandbox reported as "up" whose code-server URL/password
  # don't actually work is the same confusing failure mode isolation guards against.
  if ! wait_for_code_server "${container_id}"; then
    echo "error: code-server did not become ready in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  local code_server_addr
  if ! code_server_addr="$(compose "${project_name}" port sandbox 8080)"; then
    echo "error: failed to resolve code-server's published port for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  echo
  echo "Sandbox '${project_name}' is up."
  echo "  Project dir:  ${project_dir} -> /workspace"
  echo "  Enter with:   docker exec -it -u dev ${container_id} bash"
  echo "  code-server:  http://${code_server_addr}"
  echo "  Password:     docker exec -u dev ${container_id} grep '^password:' /home/${SANDBOX_USER}/.config/code-server/config.yaml"
  if [[ "${dind_cache_volume}" != "sandbox-cache-docker-layers" ]]; then
    echo "  Docker image-layer cache: instance-scoped (another running instance already holds the shared cache)"
  fi
}

running_sandbox_project_names() {
  docker ps --filter 'label=com.docker.compose.project' --format '{{.Label "com.docker.compose.project"}}' \
    | sort -u | grep '^sandbox-' || true
}

cmd_down() {
  local project_dir=""
  local name=""
  local name_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ "${name_given}" == true && -n "${project_dir}" ]]; then
    echo "error: pass either <project-dir> or --name, not both" >&2
    exit 1
  fi

  local project_name
  # `down` only removes resources, so it never materializes the bind mount -- but
  # compose still validates the volume spec while loading the file, and an empty
  # PROJECT_DIR turns that spec into ":/workspace", which compose rejects. Keep a
  # valid absolute path for the --name and no-argument forms, where the dir isn't
  # known (or, for --name, may belong to a different instance entirely).
  local resolved_project_dir="/nonexistent"
  if [[ "${name_given}" == true ]]; then
    project_name="$(compose_project_name_for_name "${name}")" || exit 1
  elif [[ -n "${project_dir}" ]]; then
    resolved_project_dir="$(cd "${project_dir}" && pwd -P)"
    project_name="$(compose_project_name "${resolved_project_dir}")"
  else
    local names
    names="$(running_sandbox_project_names)"
    local count
    count="$(grep -c . <<<"${names}" || true)"
    if [[ -z "${names}" || "${count}" -eq 0 ]]; then
      echo "error: no running sandbox instances found" >&2
      exit 1
    elif [[ "${count}" -gt 1 ]]; then
      echo "error: multiple sandbox instances running, specify a project directory or --name:" >&2
      echo "${names}" >&2
      exit 1
    fi
    project_name="${names}"
  fi

  # The isolation rules live inside the container, so removing it removes them too.
  export PROJECT_DIR="${resolved_project_dir}"
  export SANDBOX_ENV_FILE="/dev/null"

  # Fails loudly rather than letting `compose down` silently exit 0 against a
  # project with nothing running (e.g. a typo'd --name, or a <project-dir> whose
  # instance was actually started with --name and so lives under a different
  # project name) -- found in review: without this, a caller relying on the exit
  # code to confirm teardown is misled into thinking the instance it meant to stop
  # is gone when it's still running.
  if [[ -z "$(compose "${project_name}" ps -q sandbox 2>/dev/null || true)" ]]; then
    echo "error: no running sandbox instance found for '${project_name#sandbox-}'" >&2
    exit 1
  fi

  compose "${project_name}" down
}

# One line of `list`'s output for an already-confirmed-running instance.
# Looks the container up directly by its compose labels rather than via
# `compose ps` (unlike check_name_not_in_use_by_other_dir/cmd_down): `list` is
# read-only and has no project directory of its own to export as PROJECT_DIR,
# and docker-compose.yml's `${PROJECT_DIR}:/workspace` has no default, so a
# `compose` call here would need PROJECT_DIR exported per *instance* just to
# satisfy validation, for a value `list` doesn't otherwise need at all.
list_row() {
  local project_name="$1"
  local container_id
  container_id="$(docker ps -q \
    --filter "label=com.docker.compose.project=${project_name}" \
    --filter "label=com.docker.compose.service=sandbox")"
  if [[ -z "${container_id}" ]]; then
    return
  fi

  local project_dir
  project_dir="$(container_workspace_dir "${container_id}")"

  # Best-effort: an instance mid-`up` (container running, code-server port not
  # published yet) still deserves a row rather than making the whole `list`
  # command fail.
  local code_server_addr
  code_server_addr="$(docker port "${container_id}" 8080 2>/dev/null || true)"

  printf '%-30s %-45s %s\n' \
    "${project_name#sandbox-}" "${project_dir:-?}" "${code_server_addr:-(not ready)}"
}

cmd_list() {
  if [[ $# -gt 0 ]]; then
    echo "error: 'list' does not take any arguments" >&2
    usage >&2
    exit 1
  fi

  local names
  names="$(running_sandbox_project_names)"
  if [[ -z "${names}" ]]; then
    echo "No sandbox instances are running."
    return 0
  fi

  printf '%-30s %-45s %s\n' "NAME" "PROJECT DIR" "CODE-SERVER"
  local project_name
  while IFS= read -r project_name; do
    list_row "${project_name}"
  done <<<"${names}"
}

main() {
  local sub="${1:-}"
  case "${sub}" in
    up)
      shift
      cmd_up "$@"
      ;;
    down)
      shift
      cmd_down "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    -h | --help | "")
      usage
      ;;
    *)
      echo "error: unknown subcommand '${sub}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
