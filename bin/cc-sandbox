#!/usr/bin/env bash
# CLI entrypoint for the isolated dev sandbox (see .scratch/isolated-dev-sandbox/spec.md).
set -euo pipefail

CC_SANDBOX_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
COMPOSE_FILE="${CC_SANDBOX_ROOT}/sandbox/docker-compose.yml"

# The non-root account inside the image (sandbox/Dockerfile's USERNAME), i.e. the
# user whose traffic the isolation rules apply to.
SANDBOX_USER=dev

# Fixed, .gitignore'd path inside the build context (ticket 12, ADR-0007) that
# sandbox/Dockerfile's COPY reads the corporate CA certificate from at build
# time, and that docker-compose.yml's dind service bind-mounts at run time --
# staged fresh from ~/.cc-sandbox/ca-cert.crt on every `up` so both consumers
# see the exact same bytes from a single copy step.
CA_CERT_DEST="${CC_SANDBOX_ROOT}/sandbox/ca-cert.crt"

usage() {
  cat <<'EOF'
Usage:
  bin/cc-sandbox up <project-dir> [--profile <name>] [--name <slug>]
  bin/cc-sandbox down [project-dir] [--name <slug>]
  bin/cc-sandbox list
  bin/cc-sandbox exec [project-dir] [--name <slug>] [-- <command...>]
  bin/cc-sandbox password [project-dir] [--name <slug>]

  up    Build and start the sandbox container, bind-mounting <project-dir> at /workspace.
        --profile loads ~/.cc-sandbox/env.<name> (see docs/adr/0003) and injects its
        variables into the container so Claude Code is authenticated without an
        interactive login. <name> may be any string of letters, digits, '-', and
        '_' -- there's no fixed set of profiles, so you can keep one per client
        or engagement rather than just "private"/"work". Pass --profile with no
        name (or --profile= with nothing after the '=') to pick one
        interactively from ~/.cc-sandbox/env.* instead (see docs/adr/0006).
        --name gives the instance an explicit slug, so multiple instances (e.g. of
        the same or different project dirs) can run side by side (see ticket 06).
        Without --name, the instance is named after <project-dir> as before.
        If ~/.cc-sandbox/ca-cert.crt and/or ~/.cc-sandbox/proxy.env exist, they are
        picked up automatically (no flag needed) and applied to both the main
        container and the DinD sidecar (see docs/adr/0007).
  down  Tear down a sandbox instance, identified by <project-dir> or by --name
        (whichever the matching 'up' used). If neither is given, the single
        running instance (if there is exactly one) is torn down.
  list  Show every currently running sandbox instance: its name/slug, the
        project directory it has mounted, and its code-server address.
  exec  Run a command inside a running instance's container as the sandbox user
        (default: bash, an interactive shell). Identified the same way as
        'down': by <project-dir>, by --name, or, if both are omitted, the
        single running instance (if there is exactly one).
  password
        Print a running instance's code-server password. Identified the same
        way as 'exec'.
EOF
}

# Resolves --profile <name> to its host-side, git-ignored env file (see
# docs/adr/0003-auth-injection-per-host-profile.md). <name> isn't a fixed
# private/work choice -- any string of letters/digits/-/_ works, so a developer
# can keep one profile per client or engagement. The charset restriction exists
# only to keep the name safe to interpolate into a path (no '/', no '..').
# Fails loudly rather than silently skipping injection, since a sandbox that
# looks up but isn't actually authenticated is a confusing failure mode to debug
# from inside bypass permissions.
resolve_profile_env_file() {
  local profile="$1"
  if [[ -z "${profile}" ]]; then
    echo "error: --profile requires a non-empty value" >&2
    exit 1
  fi
  if [[ ! "${profile}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "error: invalid profile name '${profile}' (use only letters, digits, '-', and '_')" >&2
    exit 1
  fi

  if [[ -z "${HOME:-}" ]]; then
    echo "error: \$HOME is not set; cannot resolve --profile ${profile}" >&2
    exit 1
  fi

  local path="${HOME}/.cc-sandbox/env.${profile}"
  if [[ ! -f "${path}" ]]; then
    echo "error: profile file not found: ${path}" >&2
    echo "Create it with the '${profile}' profile's environment variables before using --profile ${profile}." >&2
    exit 1
  fi
  echo "${path}"
}

# Prompts the user to pick a profile from ~/.cc-sandbox/env.* when --profile is
# given without a name (see docs/adr/0006-interactive-profile-selection.md).
# Only lists names that pass the same charset check resolve_profile_env_file
# enforces, so whatever gets picked here is guaranteed to also resolve there.
# Prints the chosen name on stdout (for the caller to capture); everything
# else, including the confirmation echo, goes to stderr so it doesn't pollute
# that capture.
select_profile_interactive() {
  if [[ -z "${HOME:-}" ]]; then
    echo "error: \$HOME is not set; cannot list profiles" >&2
    exit 1
  fi
  # Fails closed rather than silently falling back to no profile: a non-interactive
  # caller (CI, a script) that hits this has almost certainly made a mistake, and
  # the sandbox coming up unauthenticated would be a confusing failure to debug.
  if [[ ! -t 0 ]]; then
    echo "error: --profile needs a name in a non-interactive shell (got none to prompt for)" >&2
    exit 1
  fi

  local dir="${HOME}/.cc-sandbox"
  local -a profiles=()
  local path base
  shopt -s nullglob
  for path in "${dir}"/env.*; do
    base="${path##*/env.}"
    if [[ "${base}" =~ ^[A-Za-z0-9_-]+$ ]]; then
      profiles+=("${base}")
    fi
  done
  shopt -u nullglob

  if [[ "${#profiles[@]}" -eq 0 ]]; then
    echo "error: no profiles found under ${dir}/env.*" >&2
    echo "Create one before using --profile without a name." >&2
    exit 1
  fi

  local sorted
  sorted="$(printf '%s\n' "${profiles[@]}" | sort)"
  profiles=()
  while IFS= read -r base; do
    profiles+=("${base}")
  done <<<"${sorted}"

  # A single attempt only: an out-of-range number, a blank Enter, and Ctrl-D/EOF
  # (which skips the loop body entirely, leaving `chosen` unset) all fall through
  # to the same "cancelled" error below rather than re-prompting forever.
  local chosen=""
  PS3="Select a profile: "
  select chosen in "${profiles[@]}"; do
    break
  done

  if [[ -z "${chosen}" ]]; then
    echo "error: profile selection cancelled" >&2
    exit 1
  fi

  echo "Using profile: ${chosen}" >&2
  echo "${chosen}"
}

# Shared by slugify() and sanitize_name() below, so the charset a compose project
# name is allowed to contain lives in exactly one place.
to_dash_charset() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-'
}

slugify() {
  # $1 must already be a canonicalized absolute path (see compose_project_name
  # callers), so the hash suffix uniquely ties the slug to that exact directory
  # and two different paths sharing a basename (e.g. two "backend" checkouts)
  # don't collide on the same compose project name.
  local input="$1"
  local base
  base="$(to_dash_charset "$(basename "${input}")")"
  base="${base#-}"
  base="${base%-}"
  local hash
  hash="$(printf '%s' "${input}" | sha256sum | cut -c1-8)"
  echo "${base:-cc-sandbox}-${hash}"
}

compose_project_name() {
  echo "cc-sandbox-$(slugify "$1")"
}

# Sanitizes a user-supplied --name into the same charset slugify() produces, but
# without slugify's path-hash suffix: an explicit --name is already unique by the
# user's choice (that's the point of ticket 06 -- decoupling the instance identity
# from the project directory), so no collision-avoidance suffix is needed.
# `return 1` (not `exit`) on an empty result: called via command substitution
# below, and a plain `set -e` does not treat a failed command substitution on the
# right-hand side of an assignment as fatal, so `exit` here would only kill the
# subshell and silently leave callers with an empty/malformed name. `|| exit 1` at
# each call site is what actually stops the script.
sanitize_name() {
  local input="$1"
  local out
  out="$(to_dash_charset "${input}")"
  # Strip *all* leading/trailing dashes, not just one: unlike slugify()'s
  # basename handling, there's no hash suffix here to fall back on, so e.g.
  # "__" must reduce all the way to empty (and get rejected below) rather than
  # leaving a bare "-" as a project name.
  out="$(printf '%s' "${out}" | sed -e 's/^-*//' -e 's/-*$//')"
  if [[ -z "${out}" ]]; then
    echo "error: --name must contain at least one letter or digit" >&2
    return 1
  fi
  echo "${out}"
}

compose_project_name_for_name() {
  local slug
  slug="$(sanitize_name "$1")" || return 1
  echo "cc-sandbox-${slug}"
}

compose() {
  local project_name="$1"
  shift
  docker compose -p "${project_name}" -f "${COMPOSE_FILE}" "$@"
}

# Fails closed rather than letting `docker compose up` silently redefine an
# existing instance: without this check, `up <dirB> --name shared` while `up
# <dirA> --name shared` is still running would make compose recreate the
# `cc-sandbox` service in place with dirB's bind mount -- i.e. one instance
# silently clobbers another's container, exactly what --name (ticket 06) is
# meant to prevent by letting instances be told apart by name instead of only
# by directory. Only relevant to the --name path: the directory-derived path
# already ties the project name 1:1 to that directory, so re-running `up`
# against the same directory is the existing, intentional "keep isolation
# up to date" behavior (see network_isolation.bats).
# The host path bind-mounted at /workspace in the given container -- shared by
# check_name_not_in_use_by_other_dir (collision guard) and list_row (`list`
# output), so this inspect --format template lives in exactly one place.
container_workspace_dir() {
  docker inspect "$1" \
    --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}'
}

# The cc-sandbox service container for a given compose project name, found by
# label rather than via `compose ps` -- unlike cmd_down/cmd_up, callers here
# (list_row, cmd_exec, cmd_password) are read-only and have no project directory
# of their own to export as PROJECT_DIR for compose's validation.
container_id_for_project() {
  docker ps -q \
    --filter "label=com.docker.compose.project=$1" \
    --filter "label=com.docker.compose.service=cc-sandbox"
}

check_name_not_in_use_by_other_dir() {
  local project_name="$1"
  local project_dir="$2"
  local existing_container
  # Requires PROJECT_DIR to already be exported: docker-compose.yml's
  # `${PROJECT_DIR}:/workspace` has no `:-` default, so without it `compose ps`
  # fails validation outright (rather than reporting "no container") and that
  # failure is swallowed by `|| true` below -- silently turning this whole guard
  # into a no-op. (Found in review: this used to run before cmd_up exported
  # PROJECT_DIR.)
  if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo "error: internal: check_name_not_in_use_by_other_dir called before PROJECT_DIR was exported" >&2
    exit 1
  fi
  existing_container="$(compose "${project_name}" ps -q cc-sandbox 2>/dev/null || true)"
  if [[ -z "${existing_container}" ]]; then
    return 0
  fi
  local existing_dir
  existing_dir="$(container_workspace_dir "${existing_container}")"
  if [[ -n "${existing_dir}" && "${existing_dir}" != "${project_dir}" ]]; then
    echo "error: an instance named '${project_name#cc-sandbox-}' is already running for a different project directory (${existing_dir})" >&2
    echo "Tear it down first with 'bin/cc-sandbox down --name ${project_name#cc-sandbox-}', or choose a different --name." >&2
    exit 1
  fi
}

# Lock directories currently held by this invocation, released together by
# release_acquired_locks -- bash only supports one EXIT trap at a time, so every
# lock acquire_lock hands out has to share it rather than each registering its
# own (a second `trap ... EXIT` would silently replace the first, found in
# review while fixing the CA-cert race below).
ACQUIRED_LOCKS=()

release_acquired_locks() {
  local dir
  for dir in "${ACQUIRED_LOCKS[@]}"; do
    rmdir "${dir}" 2>/dev/null || true
  done
}

# Generic mkdir-based lock: acquires "${TMPDIR:-/tmp}/sandbox-lock-<name>",
# waiting up to 30s, and registers it in ACQUIRED_LOCKS for release via
# release_acquired_locks on the script's exit (success or failure) -- i.e. for
# exactly as long as the invocation that acquired it is still running. `mkdir`
# is atomic on POSIX filesystems, unlike a check-then-create on a plain file, so
# only one concurrent invocation can hold a given lock name at a time.
acquire_lock() {
  local name="$1"
  local label="$2"
  local lock_dir="${TMPDIR:-/tmp}/sandbox-lock-${name}"
  local waited=0
  while ! mkdir "${lock_dir}" 2>/dev/null; do
    sleep 0.2
    waited=$((waited + 1))
    if [[ "${waited}" -gt 150 ]]; then
      echo "error: timed out waiting for another '${label}' to finish" >&2
      exit 1
    fi
  done
  ACQUIRED_LOCKS+=("${lock_dir}")
  trap release_acquired_locks EXIT
}

# Serializes check_name_not_in_use_by_other_dir's check-then-act sequence (and the
# `compose up` that follows it) against another concurrent `up --name` claiming the
# *same* brand-new name: without this, two `up --name shared` invocations racing
# against each other can both see "not in use yet" before either has created a
# container, both pass the guard, and the second `compose up -d --build` silently
# recreates/clobbers the first's container (found in review).
acquire_name_lock() {
  local project_name="$1"
  acquire_lock "${project_name}" "bin/cc-sandbox up --name ${project_name#cc-sandbox-}"
}

# Stages ~/.cc-sandbox/ca-cert.crt (if present) into the build context at
# CA_CERT_DEST (ticket 12, ADR-0007) so sandbox/Dockerfile's COPY and
# docker-compose.yml's dind bind mount both pick it up. Also removes any stale
# copy left by a previous `up` when the host no longer has one -- otherwise a
# deleted corporate CA would keep getting baked into fresh builds silently.
#
# CA_CERT_DEST is a single path shared by every instance's build regardless of
# --name, so callers must hold the "ca-cert-build" lock (see acquire_lock) for
# as long as this file's content matters -- from this call through the
# `compose ... build` that reads it -- otherwise two concurrent `up`s (ticket
# 06) can race and one instance's image gets built with the wrong CA (found in
# review).
stage_ca_certificate() {
  local src="${HOME:-}/.cc-sandbox/ca-cert.crt"
  if [[ -n "${HOME:-}" && -f "${src}" ]]; then
    cp "${src}" "${CA_CERT_DEST}"
  else
    rm -f "${CA_CERT_DEST}"
  fi
}

# Loads ~/.cc-sandbox/proxy.env (if present) into this shell's own environment
# (ticket 12, ADR-0007), so its HTTP_PROXY/HTTPS_PROXY/NO_PROXY reach BuildKit's
# automatic proxy-arg propagation at `compose build`, and so docker-compose.yml
# can interpolate them into the dind service's `environment:` at `compose up`.
# Also sets CC_SANDBOX_PROXY_ENV_FILE (for the cc-sandbox service's own
# env_file, see docker-compose.yml) and CC_SANDBOX_NO_PROXY. A missing file is
# not an error -- unlike --profile, a proxy is a property of the host machine,
# not something explicitly requested per invocation.
#
# CC_SANDBOX_NO_PROXY (NO_PROXY plus "dind") overrides the cc-sandbox service's
# own NO_PROXY in docker-compose.yml, not the dind service's: it's the `docker`
# CLI running *inside* cc-sandbox (DOCKER_HOST=tcp://dind:2375) that honors
# HTTP_PROXY/HTTPS_PROXY for that connection, so without "dind" in *its*
# NO_PROXY a configured proxy would try to tunnel the sandbox<->DinD control
# connection through itself and break docker/Testcontainers entirely whenever a
# proxy is set (found in review).
load_proxy_env() {
  export CC_SANDBOX_PROXY_ENV_FILE="/dev/null"
  local path="${HOME:-}/.cc-sandbox/proxy.env"
  if [[ -n "${HOME:-}" && -f "${path}" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "${path}"
    set +a
    export CC_SANDBOX_PROXY_ENV_FILE="${path}"
  fi
  export CC_SANDBOX_NO_PROXY="${NO_PROXY:-}${NO_PROXY:+,}dind,localhost,127.0.0.1"
}

# Applies the isolation rules from inside the container, as root
# (see docs/adr/0004-network-isolation-in-container-owner-match.md).
# Nothing is installed on the host, so `down` has no rules to clean up -- they die
# with the container.
apply_network_isolation() {
  local container_id="$1"
  docker exec -u root "${container_id}" /usr/local/sbin/cc-sandbox-isolate "${SANDBOX_USER}"
}

# Populates a Playwright cache volume created before ticket 10. This deliberately
# runs only after apply_network_isolation: doing it from the container entrypoint
# could start a browser download in the gap before the OUTPUT rules are installed
# (the startup-window constraint documented by ADR-0004). New volumes are already
# seeded from the image, so this is normally a cheap no-op. The shared-volume lock
# serializes the one-time repair when multiple instances start together.
ensure_playwright_browser() {
  local container_id="$1"
  docker exec -u "${SANDBOX_USER}" "${container_id}" bash -lc '
    mkdir -p "${HOME}/.cache/ms-playwright"
    (
      flock 9
      playwright install chromium
    ) 9>"${HOME}/.cache/ms-playwright/.install.lock"
  '
}

# Applies the DinD sidecar's isolation rules (ticket 05, see
# sandbox/isolate-forward.sh): blocks containers started inside it from reaching
# host-side services, the same way apply_network_isolation does for the sandbox
# container itself.
apply_dind_network_isolation() {
  local project_name="$1"
  local dind_container_id
  dind_container_id="$(compose "${project_name}" ps -q dind)"
  if [[ -z "${dind_container_id}" ]]; then
    return 1
  fi
  docker exec -u root "${dind_container_id}" sh /usr/local/sbin/cc-sandbox-isolate-forward
}

# Installs the corporate CA certificate into the DinD sidecar (ticket 12,
# ADR-0007), the same docker-exec-as-root pattern
# apply_network_isolation/apply_dind_network_isolation use. docker-compose.yml
# bind-mounts CC_SANDBOX_CA_CERT_FILE (or /dev/null) into the sidecar's
# ca-certificates.d, so this just has to trigger Alpine's
# update-ca-certificates -- skipped entirely when there's nothing to install.
apply_dind_ca_certificate() {
  local project_name="$1"
  if [[ "${CC_SANDBOX_CA_CERT_FILE}" == "/dev/null" ]]; then
    return 0
  fi
  local dind_container_id
  dind_container_id="$(compose "${project_name}" ps -q dind)"
  if [[ -z "${dind_container_id}" ]]; then
    return 1
  fi
  docker exec -u root "${dind_container_id}" update-ca-certificates
}

# Shared by wait_for_dind/wait_for_code_server below: both are "poll a readiness
# command inside the container for up to 30s" and differ only in that command.
wait_until() {
  local container_id="$1"
  shift
  local _
  for _ in $(seq 1 30); do
    if docker exec -u "${SANDBOX_USER}" "${container_id}" "$@" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# The nested Docker daemon in the `dind` service takes a moment to start listening
# after the container itself is running. Poll instead of assuming it's ready, so
# `up` doesn't report success before `docker`/Testcontainers actually work inside
# the sandbox.
wait_for_dind() {
  wait_until "$1" docker info
}

# code-server (a Node process) takes a moment to start listening after the
# container itself is running. Poll instead of assuming it's ready, so `up`
# doesn't report a URL that isn't actually serving anything yet.
wait_for_code_server() {
  wait_until "$1" curl -sS -m 2 -o /dev/null http://127.0.0.1:8080/
}

# True if some *other* already-running instance's dind sidecar currently has the
# globally-shared Docker image-layer cache volume mounted. containerd's metadata
# store inside that volume takes an exclusive lock on dockerd startup, so a second
# dind sharing it concurrently would hang rather than start (see
# sandbox/docker-compose.yml's DIND_CACHE_VOLUME comment; verified directly in
# review against two real docker:28-dind containers). Excludes the given project's
# own containers so re-running `up` on an already-running instance doesn't flip its
# own cache from shared to per-instance on every call.
dind_cache_volume_in_use_by_other_project() {
  local volume_name="$1"
  local own_project_name="$2"
  local cid other_project
  for cid in $(docker ps -q --filter "volume=${volume_name}"); do
    other_project="$(docker inspect "${cid}" --format '{{ index .Config.Labels "com.docker.compose.project" }}' 2>/dev/null || true)"
    if [[ -n "${other_project}" && "${other_project}" != "${own_project_name}" ]]; then
      return 0
    fi
  done
  return 1
}

cmd_up() {
  local project_dir=""
  local profile=""
  local profile_given=false
  local profile_interactive=false
  local name=""
  local name_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        # A missing value (end of args, or the next token looking like another
        # flag) means "let me pick one interactively" rather than an error --
        # see docs/adr/0006-interactive-profile-selection.md. A profile name
        # that happens to start with '-' still works via --profile=-name.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          profile=""
          profile_given=true
          profile_interactive=true
          shift
        else
          profile="$2"
          profile_given=true
          shift 2
        fi
        ;;
      --profile=*)
        profile="${1#--profile=}"
        profile_given=true
        if [[ -z "${profile}" ]]; then
          profile_interactive=true
        fi
        shift
        ;;
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${project_dir}" ]]; then
    echo "error: 'up' requires a project directory" >&2
    usage >&2
    exit 1
  fi

  # Deferred until argument parsing/validation is fully done, so an unrelated
  # mistake elsewhere on the command line (a missing project-dir, an unknown
  # flag) fails fast instead of prompting the user first and then failing anyway.
  if [[ "${profile_interactive}" == true ]]; then
    profile="$(select_profile_interactive)" || exit 1
  fi

  project_dir="$(cd "${project_dir}" && pwd -P)"
  # Exported before any `compose` call below (including inside
  # check_name_not_in_use_by_other_dir), since docker-compose.yml's
  # `${PROJECT_DIR}:/workspace` has no default and compose validates it while
  # loading the file even for a plain `ps`.
  export PROJECT_DIR="${project_dir}"

  local project_name
  if [[ "${name_given}" == true ]]; then
    project_name="$(compose_project_name_for_name "${name}")" || exit 1
    acquire_name_lock "${project_name}"
    check_name_not_in_use_by_other_dir "${project_name}" "${project_dir}"
  else
    project_name="$(compose_project_name "${project_dir}")"
  fi

  # /dev/null keeps docker-compose.yml's env_file resolvable even without --profile.
  local env_file="/dev/null"
  if [[ "${profile_given}" == true ]]; then
    env_file="$(resolve_profile_env_file "${profile}")"
  fi
  export CC_SANDBOX_ENV_FILE="${env_file}"

  # ticket 07: use the globally-shared Docker image-layer cache volume unless
  # another already-running instance currently holds it (see
  # dind_cache_volume_in_use_by_other_project and docker-compose.yml's
  # DIND_CACHE_VOLUME comment for why sharing it concurrently doesn't work).
  local dind_cache_volume="cc-sandbox-cache-docker-layers"
  if dind_cache_volume_in_use_by_other_project "${dind_cache_volume}" "${project_name}"; then
    dind_cache_volume="cc-sandbox-cache-docker-layers-${project_name}"
  fi
  export DIND_CACHE_VOLUME="${dind_cache_volume}"

  # ticket 12 / ADR-0007: corporate CA certificate and proxy settings are a
  # property of the host machine, not something explicit like --profile, so both
  # are picked up automatically when present rather than requiring a flag.
  # acquire_lock guards CA_CERT_DEST (shared by every instance's build) against
  # a concurrent `up`'s own build reading it mid-write -- see stage_ca_certificate.
  acquire_lock "ca-cert-build" "bin/cc-sandbox up"
  stage_ca_certificate
  export CC_SANDBOX_CA_CERT_FILE="/dev/null"
  if [[ -f "${CA_CERT_DEST}" ]]; then
    export CC_SANDBOX_CA_CERT_FILE="${CA_CERT_DEST}"
  fi
  load_proxy_env

  compose "${project_name}" up -d --build

  local container_id
  container_id="$(compose "${project_name}" ps -q cc-sandbox)"

  # Fail closed: a sandbox that came up without its isolation rules is worse than
  # no sandbox at all, since the whole point is to run Claude Code unsupervised in it.
  if [[ -z "${container_id}" ]] || ! apply_network_isolation "${container_id}"; then
    echo "error: failed to apply network isolation for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  if ! ensure_playwright_browser "${container_id}"; then
    echo "error: failed to install the Playwright browser in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  # wait_for_dind before apply_dind_network_isolation, not after: the nested dockerd
  # installs its own DOCKER-USER/DOCKER-FORWARD chains ahead of anything already in
  # FORWARD when *it* starts up (see sandbox/isolate-forward.sh and docs/adr/0004's
  # addendum). Applying our rule first would let a dockerd that finishes starting
  # afterward re-take the top position with its own ACCEPT, silently defeating the
  # isolation. `docker info` succeeding is a reasonable proxy for "dockerd has
  # already set up its own chains", since that happens during its startup, before
  # the API responds.
  if ! wait_for_dind "${container_id}"; then
    echo "error: DinD sidecar did not become ready in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  if ! apply_dind_network_isolation "${project_name}"; then
    echo "error: failed to apply network isolation for the DinD sidecar in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  if ! apply_dind_ca_certificate "${project_name}"; then
    echo "error: failed to install the corporate CA certificate in the DinD sidecar for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  # Fail closed here too: a sandbox reported as "up" whose code-server URL/password
  # don't actually work is the same confusing failure mode isolation guards against.
  if ! wait_for_code_server "${container_id}"; then
    echo "error: code-server did not become ready in '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  local code_server_addr
  if ! code_server_addr="$(compose "${project_name}" port cc-sandbox 8080)"; then
    echo "error: failed to resolve code-server's published port for '${project_name}'; tearing down" >&2
    compose "${project_name}" down >/dev/null 2>&1 || true
    exit 1
  fi

  echo
  echo "Sandbox '${project_name}' is up."
  echo "  Project dir:  ${project_dir} -> /workspace"
  echo "  Enter with:   docker exec -it -u dev ${container_id} bash"
  echo "  code-server:  http://${code_server_addr}"
  echo "  Password:     docker exec -u dev ${container_id} grep '^password:' /home/${SANDBOX_USER}/.config/code-server/config.yaml"
  if [[ "${dind_cache_volume}" != "cc-sandbox-cache-docker-layers" ]]; then
    echo "  Docker image-layer cache: instance-scoped (another running instance already holds the shared cache)"
  fi
}

running_sandbox_project_names() {
  docker ps --filter 'label=com.docker.compose.project' --format '{{.Label "com.docker.compose.project"}}' \
    | sort -u | grep '^cc-sandbox-' || true
}

cmd_down() {
  local project_dir=""
  local name=""
  local name_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ "${name_given}" == true && -n "${project_dir}" ]]; then
    echo "error: pass either <project-dir> or --name, not both" >&2
    exit 1
  fi

  local project_name
  # `down` only removes resources, so it never materializes the bind mount -- but
  # compose still validates the volume spec while loading the file, and an empty
  # PROJECT_DIR turns that spec into ":/workspace", which compose rejects. Keep a
  # valid absolute path for the --name and no-argument forms, where the dir isn't
  # known (or, for --name, may belong to a different instance entirely).
  local resolved_project_dir="/nonexistent"
  if [[ "${name_given}" == true ]]; then
    project_name="$(compose_project_name_for_name "${name}")" || exit 1
  elif [[ -n "${project_dir}" ]]; then
    resolved_project_dir="$(cd "${project_dir}" && pwd -P)"
    project_name="$(compose_project_name "${resolved_project_dir}")"
  else
    local names
    names="$(running_sandbox_project_names)"
    local count
    count="$(grep -c . <<<"${names}" || true)"
    if [[ -z "${names}" || "${count}" -eq 0 ]]; then
      echo "error: no running sandbox instances found" >&2
      exit 1
    elif [[ "${count}" -gt 1 ]]; then
      echo "error: multiple sandbox instances running, specify a project directory or --name:" >&2
      echo "${names}" >&2
      exit 1
    fi
    project_name="${names}"
  fi

  # The isolation rules live inside the container, so removing it removes them too.
  export PROJECT_DIR="${resolved_project_dir}"
  export CC_SANDBOX_ENV_FILE="/dev/null"

  # Fails loudly rather than letting `compose down` silently exit 0 against a
  # project with nothing running (e.g. a typo'd --name, or a <project-dir> whose
  # instance was actually started with --name and so lives under a different
  # project name) -- found in review: without this, a caller relying on the exit
  # code to confirm teardown is misled into thinking the instance it meant to stop
  # is gone when it's still running.
  if [[ -z "$(compose "${project_name}" ps -q cc-sandbox 2>/dev/null || true)" ]]; then
    echo "error: no running sandbox instance found for '${project_name#cc-sandbox-}'" >&2
    exit 1
  fi

  compose "${project_name}" down
}

# One line of `list`'s output for an already-confirmed-running instance.
# Looks the container up directly by its compose labels rather than via
# `compose ps` (unlike check_name_not_in_use_by_other_dir/cmd_down): `list` is
# read-only and has no project directory of its own to export as PROJECT_DIR,
# and docker-compose.yml's `${PROJECT_DIR}:/workspace` has no default, so a
# `compose` call here would need PROJECT_DIR exported per *instance* just to
# satisfy validation, for a value `list` doesn't otherwise need at all.
list_row() {
  local project_name="$1"
  local container_id
  container_id="$(container_id_for_project "${project_name}")"
  if [[ -z "${container_id}" ]]; then
    return
  fi

  local project_dir
  project_dir="$(container_workspace_dir "${container_id}")"

  # Best-effort: an instance mid-`up` (container running, code-server port not
  # published yet) still deserves a row rather than making the whole `list`
  # command fail.
  local code_server_addr
  code_server_addr="$(docker port "${container_id}" 8080 2>/dev/null || true)"

  printf '%-30s %-45s %s\n' \
    "${project_name#cc-sandbox-}" "${project_dir:-?}" "${code_server_addr:-(not ready)}"
}

cmd_list() {
  if [[ $# -gt 0 ]]; then
    echo "error: 'list' does not take any arguments" >&2
    usage >&2
    exit 1
  fi

  local names
  names="$(running_sandbox_project_names)"
  if [[ -z "${names}" ]]; then
    echo "No sandbox instances are running."
    return 0
  fi

  printf '%-30s %-45s %s\n' "NAME" "PROJECT DIR" "CODE-SERVER"
  local project_name
  while IFS= read -r project_name; do
    list_row "${project_name}"
  done <<<"${names}"
}

# Resolves <project-dir>/--name to a running instance's compose project name,
# the same rule cmd_down uses: both optional and mutually exclusive, falling
# back to the sole running instance when neither is given. Shared by cmd_exec
# and cmd_password, which -- like cmd_down and unlike cmd_up -- operate on an
# instance that must already exist rather than materializing one. Prints the
# project name on stdout; everything else goes to stderr. Uses `return`, not
# `exit`, so callers capturing this via command substitution get a clean
# failure to react to (see sanitize_name's comment for why).
resolve_running_instance() {
  local project_dir="$1"
  local name="$2"
  local name_given="$3"

  if [[ "${name_given}" == true && -n "${project_dir}" ]]; then
    echo "error: pass either <project-dir> or --name, not both" >&2
    return 1
  fi

  if [[ "${name_given}" == true ]]; then
    compose_project_name_for_name "${name}"
    return
  fi

  if [[ -n "${project_dir}" ]]; then
    local resolved_dir
    resolved_dir="$(cd "${project_dir}" && pwd -P)"
    compose_project_name "${resolved_dir}"
    return
  fi

  local names
  names="$(running_sandbox_project_names)"
  local count
  count="$(grep -c . <<<"${names}" || true)"
  if [[ -z "${names}" || "${count}" -eq 0 ]]; then
    echo "error: no running sandbox instances found" >&2
    return 1
  elif [[ "${count}" -gt 1 ]]; then
    echo "error: multiple sandbox instances running, specify a project directory or --name:" >&2
    echo "${names}" >&2
    return 1
  fi
  echo "${names}"
}

# Shared by cmd_exec and cmd_password: resolves the target instance and fails
# closed with a clear message (rather than a raw `docker exec` error) if its
# container isn't running. Prints the container id on stdout.
resolve_running_container() {
  local project_dir="$1"
  local name="$2"
  local name_given="$3"

  local project_name
  project_name="$(resolve_running_instance "${project_dir}" "${name}" "${name_given}")" || return 1

  local container_id
  container_id="$(container_id_for_project "${project_name}")"
  if [[ -z "${container_id}" ]]; then
    echo "error: no running container for '${project_name#cc-sandbox-}'; run 'bin/cc-sandbox up' first" >&2
    return 1
  fi
  echo "${container_id}"
}

cmd_exec() {
  local project_dir=""
  local name=""
  local name_given=false
  local -a cmd=()
  local cmd_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      --)
        shift
        cmd=("$@")
        cmd_given=true
        break
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  local container_id
  container_id="$(resolve_running_container "${project_dir}" "${name}" "${name_given}")" || exit 1

  if [[ "${cmd_given}" != true ]]; then
    cmd=(bash)
  fi

  # -t needs a TTY to allocate a pseudo one against; without this check, a
  # non-interactive caller (a script, a CI job, an output pipe) would hit
  # docker's "the input device is not a TTY" error even though -i alone would
  # have worked fine for it (mirrors `docker compose exec`'s own behavior).
  local -a tty_flags=(-i)
  if [[ -t 0 ]]; then
    tty_flags=(-it)
  fi

  # Replaces this process rather than being run as a child: the whole point is
  # to hand the caller's terminal (and exit code) directly to the container.
  exec docker exec "${tty_flags[@]}" -u "${SANDBOX_USER}" "${container_id}" "${cmd[@]}"
}

cmd_password() {
  local project_dir=""
  local name=""
  local name_given=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ $# -lt 2 ]]; then
          echo "error: --name requires an argument" >&2
          exit 1
        fi
        name="$2"
        name_given=true
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        name_given=true
        shift
        ;;
      -*)
        echo "error: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${project_dir}" ]]; then
          echo "error: unexpected argument '$1'" >&2
          exit 1
        fi
        project_dir="$1"
        shift
        ;;
    esac
  done

  local container_id
  container_id="$(resolve_running_container "${project_dir}" "${name}" "${name_given}")" || exit 1

  # Value only, no label: meant to be usable in a pipe (e.g. `| pbcopy`), same
  # as the raw value a developer would get by hand-running the command `up`
  # prints for this.
  docker exec -u "${SANDBOX_USER}" "${container_id}" \
    grep '^password:' "/home/${SANDBOX_USER}/.config/code-server/config.yaml" \
    | sed 's/^password: *//'
}

main() {
  local sub="${1:-}"
  case "${sub}" in
    up)
      shift
      cmd_up "$@"
      ;;
    down)
      shift
      cmd_down "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    exec)
      shift
      cmd_exec "$@"
      ;;
    password)
      shift
      cmd_password "$@"
      ;;
    -h | --help | "")
      usage
      ;;
    *)
      echo "error: unknown subcommand '${sub}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
