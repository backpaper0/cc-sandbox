{# 環境変数 GIT_USER_NAME / GIT_USER_EMAIL は provisioning.sh がホストの git config から渡す -#}
{# 環境変数 GIT_USER_SIGNINGKEY は任意。設定されていればコミット・タグに署名する -#}
{% set signingkey = env.GIT_USER_SIGNINGKEY | default(value="") -%}
[user]
    name = {{ env.GIT_USER_NAME }}
    email = {{ env.GIT_USER_EMAIL }}
{%- if signingkey %}
    signingkey = {{ signingkey }}
[commit]
    gpgsign = true
[tag]
    gpgsign = true
{%- endif %}
[core]
    editor = vim
    quotepath = false
[init]
    defaultBranch = main
[color]
    ui = auto
[alias]
    co = checkout
    ci = commit
    st = status
    br = branch
    lg = log --graph --decorate --branches
    # 直前のコミットにステージ済みの変更を取り込み、作者と日時を自分・現在時刻に更新する
    ca = commit --amend --no-edit --reset-author
