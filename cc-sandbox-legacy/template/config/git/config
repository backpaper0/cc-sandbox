[color]
	ui = auto
[alias]
    co = checkout
    ci = commit
    st = status
    br = branch
    ca = commit --amend --no-edit --reset-author
[core]
	editor = vim
	quotepath = false
[fetch]
	prune = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
